<!DOCTYPE html>
<html>
  <head>
    <title>Words</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag 'application', cache: false %>
    <%= javascript_importmap_tags %>
    <%= javascript_pack_tag 'application', 'data-turbolinks-track': 'reload' %>
  </head>

  <body>
        <div class='top_navigation'>
          <nav>
            <ul>
              <li>Sign out</li>
              <li>Sign in</li>
              <li>Sign up</li>
            </ul>
          </nav>
        </div>
        <div class='features_navigation'>
          <div class='features_navigation_aside_placeholder'></div>
          <nav>
            <ul>
              <li class="features_list_divider"></li>
              <li class="features_list">Books</li>
              <li class="features_list_divider"></li>
              <li class="features_list">Bookmarks</li>
              <li class="features_list_divider"></li>
              <li class="features_list">Trash</li>
              <li class="features_list_divider"></li>
              <li class="features_list">Search history</li>
              <li class="features_list_divider"></li>
            </ul>
          </nav>
          <div class='features_navigation_aside_placeholder'></div>
        </div>
        <div class='action_navigation'>
          <nav>
            <ul>
              <li>New book</li>
              <li>New translation</li>
            </ul>
            <div class='action_navigation_aside_placeholder'>adasd</div>
            <form>
              <input type="text" id="fname" name="fname">
              <input type="submit" value="Search">
            </form>
          </nav>
        </div>
      <%- if @current_user %>
        <%= image_tag("design/design.png") %>
        <%= link_to "sign out", sign_out_path if session[:email] %>
        <div>
          | Email: <%= @current_user.email %> |
          <%= link_to "Need to do", todos_path%> |
          <%= link_to "Articles", articles_path%> |
          <%= link_to "Roadmap", roadmap_path%> |
          <%= link_to "Books", user_books_path(user_id: @current_user.id) %> |
          <%= link_to "Account", show_account_path(user_id: @current_user, account_id: @current_account)%> |
          <%= link_to "Vocabularies", user_vocabularies_path(user_id: @current_user)%> |
          <b>native language:</b> <%= @user_native_language[:name]%> <%= image_tag(@user_native_language[:icon], size: "32x20", alt: "Language icon") %> |
          <b>to learn language:</b> <%= @user_to_learn_language[:name]%> <%= image_tag(@user_to_learn_language[:icon], size: "32x20", alt: "Language icon") %> |
          <%= @version %>
        </div>
      <%- end %>
    <%= yield %>
  </body>
</html>

